# Supabase → Project Settings → API
# The service role key is used only on the server (Server Components / Server Actions). Never expose it to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: any random string. When set, only Vercel Cron can call /api/keep-alive.
CRON_SECRET=
